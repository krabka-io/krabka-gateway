"""Unit tests for `rustdoc_site.axl`."""

load(
    "./rustdoc_site.axl",
    "copy_tree",
    "find_rustdoc",
    "html_escape",
    "landing_page",
    "landing_row",
    "manifest_field",
    "normalize_path",
    "output_problem",
    "problems",
    "redirect_page",
    "resolve_output",
    "snake",
)
load("./testing.axl", "check_eq", "suite", "suite_task", "temp_tree")

# The two pages, spelled out rather than assembled, because what they have to
# be is exact bytes: the site is published, so
# a change here is a change to a page someone has bookmarked.
_REDIRECT_PAGE = """<!doctype html>
<meta charset="utf-8">
<meta http-equiv="refresh" content="0; url=krabka_alpha/index.html">
<title>krabka-alpha</title>
<a href="krabka_alpha/index.html">krabka-alpha</a>
"""

_LANDING_PAGE = """<!doctype html>
<html lang="en">
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>krabka-gateway API documentation</title>
<style>
  body { font: 16px/1.5 system-ui, sans-serif; margin: 2rem auto; max-width: 60rem; padding: 0 1rem; }
  table { border-collapse: collapse; width: 100%; }
  th, td { border-bottom: 1px solid #ccc; padding: 0.5rem; text-align: left; vertical-align: top; }
</style>
<h1>krabka-gateway API documentation</h1>
<p>Rustdoc for every crate in
<a href="https://github.com/krabka-io/krabka-gateway">krabka-io/krabka-gateway</a>,
rendered from the <code>main</code> branch.</p>
<table>
<thead><tr><th>Crate</th><th>What it is</th></tr></thead>
<tbody>
<tr><td><a href="krabka-alpha/krabka_alpha/index.html"><code>krabka-alpha</code></a></td><td>The alpha crate, first of its name</td></tr>
<tr><td><a href="krabka-beta/krabka_beta/index.html"><code>krabka-beta</code></a></td><td>The &quot;beta&quot; crate &amp; co.</td></tr>
</tbody>
</table>
</html>
"""

_EMPTY_LANDING_PAGE = """<!doctype html>
<html lang="en">
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>krabka-gateway API documentation</title>
<style>
  body { font: 16px/1.5 system-ui, sans-serif; margin: 2rem auto; max-width: 60rem; padding: 0 1rem; }
  table { border-collapse: collapse; width: 100%; }
  th, td { border-bottom: 1px solid #ccc; padding: 0.5rem; text-align: left; vertical-align: top; }
</style>
<h1>krabka-gateway API documentation</h1>
<p>Rustdoc for every crate in
<a href="https://github.com/krabka-io/krabka-gateway">krabka-io/krabka-gateway</a>,
rendered from the <code>main</code> branch.</p>
<table>
<thead><tr><th>Crate</th><th>What it is</th></tr></thead>
<tbody>
</tbody>
</table>
</html>
"""

def _row(name, description):
    return struct(name = name, snake = snake(name), description = description)

def _crate(package, name, rustdoc = "bazel-bin/x_doc.rustdoc", has_index = True, description = ""):
    return struct(
        package = package,
        name = name,
        snake = snake(name),
        description = description,
        rustdoc = rustdoc,
        has_index = has_index,
    )

def _test_manifest_field_reads_the_package_section(_ctx):
    lines = [
        "[package]",
        'name = "krabka-log"',
        'description = "The log"',
        "[dependencies]",
        'name = "some-dependency"',
    ]
    check_eq("the package name", manifest_field(lines, "name"), "krabka-log")
    check_eq("the description", manifest_field(lines, "description"), "The log")

def _test_manifest_field_decodes_basic_string_escapes(_ctx):
    # Each case is one TOML line (as written in a manifest) and the value it means.
    cases = [
        ("an escaped quote", 'description = "The \\"beta\\" crate"', 'The "beta" crate'),
        ("an escaped backslash", 'description = "a\\\\b"', "a\\b"),
        ("a newline", 'description = "a\\nb"', "a\nb"),
        ("a tab", 'description = "a\\tb"', "a\tb"),
        ("a carriage return", 'description = "a\\rb"', "a\rb"),
        ("a backspace", 'description = "a\\bb"', "a" + chr(8) + "b"),
        ("a form feed", 'description = "a\\fb"', "a" + chr(12) + "b"),
        ("a short unicode escape", 'description = "caf\\u00e9"', "caf" + chr(0xE9)),
        ("an upper-case hex unicode escape", 'description = "\\u00E9!"', chr(0xE9) + "!"),
        ("a long unicode escape", 'description = "\\U0001F600"', chr(0x1F600)),
        ("an escape before the closing quote", 'description = "end\\\\"', "end\\"),
        ("a single quote", "description = \"it's\"", "it's"),
    ]
    for label, line, want in cases:
        check_eq(label, manifest_field(["[package]", line], "description"), want)

def _test_manifest_field_reads_literal_strings_as_written(_ctx):
    cases = [
        ("no escapes", "description = 'C:\\path\\n'", "C:\\path\\n"),
        ("a double quote", "description = 'The \"beta\" crate'", 'The "beta" crate'),
        ("an empty literal", "description = ''", ""),
        ("an unclosed literal", "description = 'abc", ""),
    ]
    for label, line, want in cases:
        check_eq(label, manifest_field(["[package]", line], "description"), want)

def _test_manifest_field_rejects_malformed_basic_strings(_ctx):
    cases = [
        ("an unknown escape", 'description = "a\\qb"'),
        ("a truncated unicode escape", 'description = "a\\u12"'),
        ("a non-hex unicode escape", 'description = "a\\u12zz"'),
        ("a surrogate", 'description = "a\\ud800"'),
        ("a code point past Unicode", 'description = "a\\U00110000"'),
        ("a dangling backslash", 'description = "a\\'),
        ("an escaped closing quote", 'description = "a\\"'),
    ]
    for label, line in cases:
        check_eq(label, manifest_field(["[package]", line], "description"), "")

def _test_html_escape(_ctx):
    cases = [
        ("plain text", "The log", "The log"),
        ("an ampersand", "a & b", "a &amp; b"),
        ("angle brackets", "Vec<T>", "Vec&lt;T&gt;"),
        ("double quotes", 'the "beta"', "the &quot;beta&quot;"),
        ("single quotes", "it's", "it&#39;s"),
        ("an existing entity is escaped once more", "&amp;", "&amp;amp;"),
        ("nothing", "", ""),
    ]
    for label, text, want in cases:
        check_eq(label, html_escape(text), want)

def _test_manifest_field_ignores_what_it_cannot_parse(_ctx):
    cases = [
        ("no such field", ['name = "krabka-log"'], "description"),
        ("workspace inheritance", ["description.workspace = true"], "description"),
        ("an unclosed value", ['description = "'], "description"),
        ("a longer field name", ['name-suffix = "x"'], "name"),
        ("a bare value", ["name = x"], "name"),
        ("a missing value", ["name ="], "name"),
        ("an unclosed literal", ["name = 'x"], "name"),
    ]
    for label, body, field in cases:
        check_eq(label, manifest_field(["[package]"] + body, field), "")

def _test_manifest_field_reads_valid_toml_layouts(_ctx):
    cases = [
        ("a trailing comment", 'name = "krabka-log" # package name', "krabka-log"),
        ("a trailing comment after a literal", "name = 'krabka-log' # package name", "krabka-log"),
        ("an indented key", '  name = "x"', "x"),
        ("a tab-indented key", '\tname = "x"', "x"),
        ("no spaces around the equals sign", 'name="x"', "x"),
        ("extra spaces around the equals sign", 'name   =   "x"', "x"),
        ("a literal string", "name = 'x'", "x"),
        ("text after the closing quote is ignored", 'description = "The "beta" crate"', "The "),
        ("an empty basic string", 'description = ""', ""),
    ]
    for label, line, want in cases:
        field = "description" if line.startswith("description") else "name"
        check_eq(label, manifest_field(["[package]", line], field), want)

def _test_manifest_field_reads_only_the_package_table(_ctx):
    cases = [
        ("before any table", ['name = "early"', "[package]", 'name = "real"'], "real"),
        ("a dependency table first", ["[dependencies]", 'name = "dep"', "[package]", 'name = "real"'], "real"),
        ("stops at the next table", ["[package]", "[dependencies]", 'name = "dep"'], ""),
        ("a table after the package", ["[package]", 'name = "real"', "[dependencies]", 'name = "dep"'], "real"),
        ("a header with a comment", ["[package] # the crate", 'name = "real"'], "real"),
        ("an indented header", ["  [package]", 'name = "real"'], "real"),
        ("no package table", ['name = "early"'], ""),
        ("a package-prefixed table", ["[package.metadata]", 'name = "meta"'], ""),
    ]
    for label, lines, want in cases:
        check_eq(label, manifest_field(lines, "name"), want)

def _test_snake_is_the_crates_module_name(_ctx):
    check_eq("one dash", snake("krabka-log"), "krabka_log")
    check_eq("two dashes", snake("krabka-remote-storage"), "krabka_remote_storage")
    check_eq("no dash", snake("krabka"), "krabka")

def _test_find_rustdoc_picks_the_doc_directory(_ctx):
    check_eq(
        "among the package's other outputs",
        find_rustdoc(["libkrabka_log.rlib", "log_doc.rustdoc", "log_doc.rustdoc.log"]),
        "log_doc.rustdoc",
    )

def _test_find_rustdoc_without_one(_ctx):
    check_eq("nothing to find", find_rustdoc(["libkrabka_log.rlib"]), "")
    check_eq("an empty listing", find_rustdoc([]), "")

def _test_find_rustdoc_is_deterministic(_ctx):
    # `read_dir` returns entries in whatever order the filesystem holds them,
    # so the first of them is arbitrary. Sorting is
    # what keeps two machines from publishing different pages.
    check_eq(
        "the sorted first",
        find_rustdoc(["b_doc.rustdoc", "a_doc.rustdoc"]),
        "a_doc.rustdoc",
    )

def _test_redirect_page(_ctx):
    check_eq("the redirect", redirect_page("krabka-alpha", "krabka_alpha"), _REDIRECT_PAGE)

def _test_landing_row(_ctx):
    check_eq(
        "one row",
        landing_row(_row("krabka-log", "The log")),
        '<tr><td><a href="krabka-log/krabka_log/index.html"><code>krabka-log</code></a></td><td>The log</td></tr>',
    )

def _test_landing_row_escapes_manifest_text(_ctx):
    check_eq(
        "an escaped row",
        landing_row(_row("krabka-<x>", 'Types like Vec<T> & "co"')),
        '<tr><td><a href="krabka-&lt;x&gt;/krabka_&lt;x&gt;/index.html"><code>krabka-&lt;x&gt;</code></a></td>' +
        "<td>Types like Vec&lt;T&gt; &amp; &quot;co&quot;</td></tr>",
    )

def _test_redirect_page_escapes_manifest_text(_ctx):
    check_eq(
        "an escaped redirect",
        redirect_page("a&b", "a&b"),
        "\n".join([
            "<!doctype html>",
            '<meta charset="utf-8">',
            '<meta http-equiv="refresh" content="0; url=a&amp;b/index.html">',
            "<title>a&amp;b</title>",
            '<a href="a&amp;b/index.html">a&amp;b</a>',
        ]) + "\n",
    )

def _test_landing_page(_ctx):
    check_eq(
        "the landing page",
        landing_page([
            _row("krabka-alpha", "The alpha crate, first of its name"),
            _row("krabka-beta", 'The "beta" crate & co.'),
        ]),
        _LANDING_PAGE,
    )

def _test_landing_page_without_crates(_ctx):
    check_eq("an empty table", landing_page([]), _EMPTY_LANDING_PAGE)

def _test_a_documented_crate_has_no_problem(_ctx):
    check_eq("nothing to report", problems([_crate("log", "krabka-log")]), [])

def _test_a_crate_without_rustdoc_output_is_reported(_ctx):
    check_eq(
        "no rustdoc directory",
        problems([_crate("log", "krabka-log", rustdoc = "")]),
        ["no rustdoc output for krabka-log under bazel-bin/crates/log"],
    )

def _test_rustdoc_output_without_the_crates_index_is_reported(_ctx):
    check_eq(
        "no index.html",
        problems([_crate("log", "krabka-log", rustdoc = "/w/bazel-bin/crates/log/log_doc.rustdoc", has_index = False)]),
        ["/w/bazel-bin/crates/log/log_doc.rustdoc has no krabka_log/index.html"],
    )

def _test_a_nameless_manifest_is_reported_once(_ctx):
    check_eq(
        "no package name",
        problems([_crate("log", "", rustdoc = "")]),
        ["crates/log/Cargo.toml declares no package name"],
    )

def _test_every_crate_is_reported_not_only_the_first(_ctx):
    # Reporting only the first would make a docgen run that produced nothing
    # at all take one CI run per crate to repair.
    check_eq(
        "both crates",
        problems([
            _crate("log", "krabka-log", rustdoc = ""),
            _crate("raft", "krabka-raft"),
            _crate("audit", "krabka-audit", rustdoc = ""),
        ]),
        [
            "no rustdoc output for krabka-log under bazel-bin/crates/log",
            "no rustdoc output for krabka-audit under bazel-bin/crates/audit",
        ],
    )

def _test_resolve_output(_ctx):
    check_eq("relative", resolve_output("/w", "site"), "/w/site")
    check_eq("nested", resolve_output("/w", "build/site"), "/w/build/site")
    check_eq("absolute", resolve_output("/w", "/var/www/site"), "/var/www/site")

def _test_normalize_path(_ctx):
    cases = [
        ("already normal", "/w/site", "/w/site"),
        ("dot segments", "/w/./site/.", "/w/site"),
        ("dot-dot segments", "/w/a/../site", "/w/site"),
        ("duplicate and trailing slashes", "/w//site///", "/w/site"),
        ("dot-dot above the root", "/../..", "/"),
        ("the root", "/", "/"),
    ]
    for label, path, want in cases:
        check_eq(label, normalize_path(path), want)

def _test_output_problem_rejects_unsafe_directories(_ctx):
    root = "/home/u/repo"
    for output in [".", "..", "../sibling", "crates", ".git", ".github", ".aspect", "bazel", "bazel-bin", "crates/x", "site/../crates", "site/../.."]:
        if not output_problem(root, resolve_output(root, output)):
            fail("relative %r was accepted" % output)
    for absolute in ["/", root, root + "/", root + "/.", "/home/u", "/home/u/repo-other", "/tmp/site", root + "/.git"]:
        if not output_problem(root, resolve_output(root, absolute)):
            fail("absolute %r was accepted" % absolute)

def _test_output_problem_accepts_a_directory_below_the_root(_ctx):
    root = "/home/u/repo"
    for output in ["site", "out/site", "./site", "build/../site", root + "/site", root + "/out/site"]:
        check_eq(output, output_problem(root, resolve_output(root, output)), "")

def _test_copy_tree_reproduces_the_whole_subtree(ctx):
    fs = ctx.std.fs
    root = temp_tree(ctx, {
        "src/font.woff2": "binary-ish",
        "src/krabka_log/index.html": "the crate index\n",
        "src/krabka_log/nested/deep.html": "deeper\n",
    })

    # An empty directory is part of the tree `cp -rL` copied, and rustdoc does
    # emit directories that hold nothing on a crate with no such items.
    fs.create_dir_all(root + "/src/empty")

    check_eq("files copied", copy_tree(fs, root + "/src", root + "/out"), 3)
    check_eq("a top-level file", fs.read_to_string(root + "/out/font.woff2"), "binary-ish")
    check_eq("a nested file", fs.read_to_string(root + "/out/krabka_log/index.html"), "the crate index\n")
    check_eq("a deeper file", fs.read_to_string(root + "/out/krabka_log/nested/deep.html"), "deeper\n")
    check_eq("the empty directory", fs.exists(root + "/out/empty"), True)

def _test_copy_tree_leaves_the_copy_writable(ctx):
    # Bazel writes its outputs read-only, and the redirect page is written into
    # the copy afterwards, so a copy that kept the source's mode would fail.
    fs = ctx.std.fs
    root = temp_tree(ctx, {"src/index.html": "rustdoc wrote this\n"})
    fs.set_permissions(root + "/src/index.html", 0o444)

    copy_tree(fs, root + "/src", root + "/out")
    check_eq("read-only source", fs.metadata(root + "/src/index.html").readonly, True)
    check_eq("writable copy", fs.metadata(root + "/out/index.html").readonly, False)

    fs.write(root + "/out/index.html", "the redirect\n")
    check_eq("overwritten", fs.read_to_string(root + "/out/index.html"), "the redirect\n")

def _test_copy_tree_keeps_the_executable_bit(ctx):
    fs = ctx.std.fs
    root = temp_tree(ctx, {"src/plain.html": "x\n", "src/tool.sh": "y\n"})
    fs.set_permissions(root + "/src/tool.sh", 0o555)

    copy_tree(fs, root + "/src", root + "/out")
    check_eq("still executable", fs.metadata(root + "/out/tool.sh").executable, True)
    check_eq("still not executable", fs.metadata(root + "/out/plain.html").executable, False)

rustdoc_site_tests = suite("rustdoc-site", [
    _test_manifest_field_reads_the_package_section,
    _test_manifest_field_decodes_basic_string_escapes,
    _test_manifest_field_reads_literal_strings_as_written,
    _test_manifest_field_rejects_malformed_basic_strings,
    _test_html_escape,
    _test_manifest_field_ignores_what_it_cannot_parse,
    _test_manifest_field_reads_valid_toml_layouts,
    _test_manifest_field_reads_only_the_package_table,
    _test_snake_is_the_crates_module_name,
    _test_find_rustdoc_picks_the_doc_directory,
    _test_find_rustdoc_without_one,
    _test_find_rustdoc_is_deterministic,
    _test_redirect_page,
    _test_landing_row,
    _test_landing_row_escapes_manifest_text,
    _test_redirect_page_escapes_manifest_text,
    _test_landing_page,
    _test_landing_page_without_crates,
    _test_a_documented_crate_has_no_problem,
    _test_a_crate_without_rustdoc_output_is_reported,
    _test_rustdoc_output_without_the_crates_index_is_reported,
    _test_a_nameless_manifest_is_reported_once,
    _test_every_crate_is_reported_not_only_the_first,
    _test_resolve_output,
    _test_normalize_path,
    _test_output_problem_rejects_unsafe_directories,
    _test_output_problem_accepts_a_directory_below_the_root,
    _test_copy_tree_reproduces_the_whole_subtree,
    _test_copy_tree_leaves_the_copy_writable,
    _test_copy_tree_keeps_the_executable_bit,
])

test_rustdoc_site = suite_task(rustdoc_site_tests)
