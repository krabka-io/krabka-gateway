{
  "name": "@krabka/sdk",
  "version": "0.0.0",
  "description": "TypeScript SDK for the Krabka gateway contract v1.",
  "type": "module",
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "bin": "./bin/conformance-adapter",
  "engines": {
    "node": ">=20"
  },
  "files": [
    "bin",
    "dist",
    "gen",
    "src"
  ],
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    },
    "./src": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./src/*": {
      "types": "./src/*.ts",
      "default": "./src/*.ts"
    },
    "./gen/*": {
      "types": "./gen/*.ts",
      "default": "./gen/*.ts"
    }
  },
  "scripts": {
    "build": "tsc && node scripts/create-adapter-bin.mjs",
    "test": "vitest run",
    "adapter": "tsx src/conformance-adapter.ts",
    "typecheck": "tsc --noEmit"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/krabka-io/krabka-gateway.git",
    "directory": "sdks/ts"
  },
  "homepage": "https://github.com/krabka-io/krabka-gateway#readme",
  "bugs": {
    "url": "https://github.com/krabka-io/krabka-gateway/issues"
  },
  "keywords": [
    "krabka",
    "kafka",
    "connectrpc",
    "sdk"
  ],
  "dependencies": {
    "@bufbuild/protobuf": "^2.16.0",
    "@connectrpc/connect": "^2.2.0",
    "@connectrpc/connect-node": "^2.2.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
