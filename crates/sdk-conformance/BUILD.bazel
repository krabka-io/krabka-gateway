load("//bazel:defs.bzl", "crate_binary", "crate_library", "crate_tests")

package(default_visibility = ["//visibility:public"])

# Consumed by `crate.from_cargo` (see //MODULE.bazel).
exports_files(["Cargo.toml"])

# The vectors every SDK adapter is replayed against. One directory, one version
# per subdirectory; the runner takes the directory as `--vectors`.
filegroup(
    name = "vectors",
    srcs = glob(["vectors/**/*.json"]),
)

crate_library(name = "sdk-conformance")

crate_binary(
    name = "conformance",
    crate_root = "src/bin/conformance.rs",
    lib = ":sdk-conformance",
)

crate_binary(
    name = "emit_cpp_codec_oracle_vectors",
    crate_root = "src/bin/emit_cpp_codec_oracle_vectors.rs",
    lib = ":sdk-conformance",
)

crate_tests(
    data = [
        ":conformance",
        ":vectors",
        "//crates/app-sdk:conformance_adapter",
        "//crates/gateway:test_scripts",
    ],
    # `self_test` runs the Bazel-built Rust adapter. Under Cargo it builds the
    # adapter with `cargo build` instead.
    env = {"KRABKA_RUST_CONFORMANCE_ADAPTER": "$(rootpath //crates/app-sdk:conformance_adapter)"},
    lib = "sdk-conformance",
    # `self_test` finds the runner through the variable that Cargo exports for
    # a `[[bin]]` in the same package, and the vectors and scripts through
    # `CARGO_MANIFEST_DIR`. Bazel sets neither. These values are relative to
    # the runfiles directory, where a test starts.
    rustc_env = {
        "CARGO_BIN_EXE_conformance": "$(rootpath :conformance)",
        "CARGO_MANIFEST_DIR": "crates/sdk-conformance",
    },
)
