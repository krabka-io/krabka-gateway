"""krabka-gateway — Bazel module (bzlmod).

Bazel is the build and test path for the Rust crates; Cargo stays the dependency
source of truth. `crate.from_cargo` reads the same `Cargo.toml` / `Cargo.lock`
that Cargo does, so there is no second dependency set to keep in sync.

The four application SDKs under //sdks are built by their own native toolchains
(CMake, Go, Gradle and npm) in `.github/workflows`. Bazel does not build them.
"""

module(
    name = "krabka_gateway",
    version = "0.5.0",
)

bazel_dep(name = "platforms", version = "1.1.0")
bazel_dep(name = "rules_rs", version = "0.1.0")
bazel_dep(name = "rules_rs_mutants", version = "0.0.1")

# rules_rs_mutants is not published to the Bazel Central Registry, so the
# `bazel_dep` above has nothing to resolve against without this override.
git_override(
    module_name = "rules_rs_mutants",
    # Resolved to a commit so the checkout is reproducible. Past v0.0.1 for
    # `//mutants:config`, without which the sweep enumerates from a synthetic
    # workspace where this repo's `.cargo/mutants.toml` is not in scope -- so
    # the exclusions written there did not exclude.
    commit = "63bb99ca9a7cb81eab1728bc5d2c9985f23c8560",
    remote = "https://github.com/robot-head/rules_rs_mutants",
)

# A hermetic C++ toolchain rather than the host's.
#
# Bazel's autodetected toolchain links with whatever the machine happens to
# have. GitHub's runners carry `ld.gold`, so it passed `-fuse-ld=gold` and every
# link action printed "the gold linker is deprecated and has known bugs with
# Rust". Pinning the toolchain links with lld instead, and makes a local build
# and a CI build the same build.
bazel_dep(name = "llvm", version = "0.8.24")

register_toolchains("@llvm//toolchain:all")

# ---------------------------------------------------------------------------
# Container image. See //packaging.
#
# apko builds the Wolfi base from a lock file. rules_img layers the Bazel-built
# gateway binary on that base, loads the image into a local daemon and pushes
# it to the registry. krabka-broker uses the same arrangement.
# ---------------------------------------------------------------------------
bazel_dep(name = "rules_img", version = "0.3.22")
bazel_dep(name = "rules_apko", version = "1.5.56")

# `sh_test`, for the checks on the image layers.
bazel_dep(name = "rules_shell", version = "0.8.0")

apko = use_extension("@rules_apko//apko:extensions.bzl", "apko")
apko.toolchain(apko_version = "v1.2.40")
apko.translate_lock(
    name = "gateway_base_lock",
    lock = "//packaging:base.apko.lock.json",
)
use_repo(apko, "apko_toolchains", "gateway_base_lock")

register_toolchains("@apko_toolchains//:all")

# Format and lint. See //tools/lint.
bazel_dep(name = "aspect_rules_lint", version = "2.9.1")

# Supplies a clippy aspect shaped the way `aspect lint` expects -- it writes the
# `rules_lint_machine` output group, which the aspect from @rules_rust does not.
bazel_dep(name = "aspect_rules_lint_rust", version = "0.0.3")
bazel_dep(name = "buildifier_prebuilt", version = "10.1.0")

# `protoc` for the gateway's build script, which generates the Connect-RPC
# stubs. The build supplies it, so the build script does not locate a vendored
# binary through that crate's own manifest path.
#
# A prebuilt binary. The `protobuf` module builds protoc from its C++ sources,
# which adds minutes of compilation to a cold run.
bazel_dep(name = "toolchains_protoc", version = "0.6.1")

# For the `@rules_proto//proto:toolchain_type` that `//bazel:protoc` resolves.
bazel_dep(name = "rules_proto", version = "7.1.0")

protoc = use_extension("@toolchains_protoc//protoc:extensions.bzl", "protoc")
protoc.toolchain(version = "v33.0")
use_repo(protoc, "toolchains_protoc_hub")

register_toolchains("@toolchains_protoc_hub//:all")

# rules_rs vends its own patched @rules_rust. `rust_doc_test` has no rules_rs
# wrapper, so it is loaded from there directly rather than from a second copy.
rules_rust = use_extension("@rules_rs//rs:rules_rust.bzl", "rules_rust")
use_repo(rules_rust, "rules_rust")

# ---------------------------------------------------------------------------
# Rust toolchain — pinned to the same channel as rust-toolchain.toml.
# ---------------------------------------------------------------------------
toolchains = use_extension("@rules_rs//rs/toolchains:module_extension.bzl", "toolchains")

# aspect_rules_lint_rust also imports this default toolchain repository.
# Configure it here so builds and Clippy use the same pinned compiler.
toolchains.toolchain(
    name = "default_rust_toolchains",
    edition = "2024",
    # rustfmt.toml sets nightly-gated options. Stable rustfmt does not fail on
    # them, it warns and silently skips them -- so a stable formatter would
    # quietly disagree with the tree, which CI formats with `cargo +nightly fmt`.
    rustfmt_version = "nightly/2026-08-14",
    # Matches rust-toolchain.toml. Letting these drift is precisely the split
    # that "one dependency source of truth" exists to avoid.
    version = "1.99.0",
)
use_repo(toolchains, "default_rust_toolchains")

register_toolchains("@default_rust_toolchains//...")

# ---------------------------------------------------------------------------
# Native `-sys` crates, built by Bazel rather than by their build scripts.
#
# rules_rs ships a well-known annotation for each and warns on every build until
# it is applied. Each otherwise compiles a bundled C library through a `cc`-crate
# build script: the host's compiler, flags and headers, none of which the
# hermetic toolchain governs.
# ---------------------------------------------------------------------------
bazel_dep(name = "aws-lc", version = "5.1.0.bcr.3")
bazel_dep(name = "zstd", version = "1.5.7.bcr.2")

# aws-lc-sys' bindings are generated, and rules_rs prefers the pregenerated set
# to running bindgen; the toolchain is still required for the paths that do.
rules_rust_bindgen = use_extension("@rules_rs//rs:rules_rust_bindgen.bzl", "rules_rust_bindgen")
use_repo(rules_rust_bindgen, "rules_rust_bindgen")

register_toolchains("@rules_rust_bindgen//:all")

# ---------------------------------------------------------------------------
# Third-party crates, resolved from the Cargo workspace.
# ---------------------------------------------------------------------------
PLATFORM_TRIPLES = [
    "aarch64-apple-darwin",
    "aarch64-unknown-linux-gnu",
    "x86_64-apple-darwin",
    "x86_64-unknown-linux-gnu",
]

crate = use_extension("@rules_rs//rs:extensions.bzl", "crate")
crate.from_cargo(
    name = "crates",
    cargo_lock = "//:Cargo.lock",
    cargo_toml = "//:Cargo.toml",
    platform_triples = PLATFORM_TRIPLES,
)

# cargo-mutants comes from its own lockfile rather than this workspace's, so the
# sweep tool is pinned independently of what the crates under test depend on.
crate.from_cargo(
    name = "mutants",
    cargo_lock = "//tools/mutants:Cargo.lock",
    cargo_toml = "//tools/mutants:Cargo.toml",
    platform_triples = PLATFORM_TRIPLES,
)

# ---------------------------------------------------------------------------
# Sibling crates live inside their repositories' Cargo workspaces, so a git
# checkout puts each one under `crates/<name>` rather than at the root.
# rules_rs cannot infer that: without the prefix it fails outright with
# "Could not compute strip_prefix". The workspace manifest is named too, so the
# member resolves against its own workspace rather than being read as a
# standalone crate.
# ---------------------------------------------------------------------------
SIBLING_MEMBERS = {
    "connectrpc-axum": "connectrpc-axum",
    "connectrpc-axum-build": "connectrpc-axum-build",
    "connectrpc-axum-core": "connectrpc-axum-core",
    "krabka-audit": "crates/audit",
    "krabka-authz": "crates/authz",
    "krabka-client-admin": "crates/client-admin",
    "krabka-client-consumer": "crates/client-consumer",
    "krabka-client-coordination": "crates/client-coordination",
    "krabka-client-core": "crates/client-core",
    "krabka-client-producer": "crates/client-producer",
    "krabka-client-streams": "crates/client-streams",
    "krabka-compression": "crates/compression",
    "krabka-format": "crates/format",
    "krabka-hlc": "crates/hlc",
    "krabka-ids": "crates/ids",
    "krabka-kafka-tap": "crates/kafka-tap",
    "krabka-kraft-core": "crates/kraft-core",
    "krabka-log": "crates/log",
    "krabka-logfmt": "crates/logfmt",
    "krabka-macros": "crates/macros",
    "krabka-metadata": "crates/metadata",
    "krabka-object-store": "crates/object-store",
    "krabka-raft": "crates/raft",
    "krabka-records-legacy": "crates/records-legacy",
    "krabka-remote-storage": "crates/remote-storage",
    "krabka-remote-storage-topic": "crates/remote-storage-topic",
    "krabka-schema-serde": "crates/schema-serde",
    "krabka-security": "crates/security",
    "krabka-telemetry": "crates/telemetry",
    "krabka-throttle": "crates/throttle",
    "krabka-trace-context": "crates/trace-context",
    "krabka-units": "crates/units",
    "krabka-verified": "crates/verified",
    "krabka-voters": "crates/voters",
}

[
    crate.annotation(
        crate = crate_name,
        strip_prefix = directory,
        workspace_cargo_toml = "Cargo.toml",
    )
    for crate_name, directory in SIBLING_MEMBERS.items()
]

# krabka-broker carries the same member annotation plus one more. Its build.rs
# reads the image digests from krabka-broker's own MODULE.bazel, two levels
# above the crate, and emits them for a guard in `src/codes/tests.rs`. That file
# is not part of the crate that rules_rs fetches, and only the broker's own
# tests read the variables. The Cargo build and the Bazel build in krabka-broker
# still run the script.
crate.annotation(
    crate = "krabka-broker",
    gen_build_script = "off",
    strip_prefix = "crates/broker",
    workspace_cargo_toml = "Cargo.toml",
)

# krabka-protocol carries the same member annotation plus one more. Its build.rs
# only checks that its checked-in `generated/` sources still match the
# `schemas/` SHAs; it emits no code. It reads its own manifest directory through
# `env!("CARGO_MANIFEST_DIR")`, which rules_rust rejects because that bakes an
# absolute build path into the artifact -- the same sources would produce
# different bytes on different machines. Nothing here needs the check, since the
# generated sources are consumed directly, and the Cargo build in
# krabka-protocol still runs it.
crate.annotation(
    crate = "krabka-protocol",
    gen_build_script = "off",
    strip_prefix = "crates/protocol",
    workspace_cargo_toml = "Cargo.toml",
)

# datafusion-common's `test_util` finds datafusion's test-data submodule through
# `env!("CARGO_MANIFEST_DIR")`. No feature gates that module, so every build of
# the library compiles it. `env!` bakes the absolute build directory into the
# artifact, and the sandboxed build rejects that. The patch reads the variable
# at run time. The only caller is a test helper, and Cargo sets the variable
# for test binaries.
crate.annotation(
    crate = "datafusion-common",
    patch_args = ["-p1"],
    patches = ["//bazel/patches:datafusion-common-manifest-dir.patch"],
)
crate.annotation(
    crate = "cargo-mutants",
    gen_binaries = ["cargo-mutants"],
    repositories = ["mutants"],
)
crate.annotation(
    crate = "aws-lc-rs",
    gen_build_script = "off",
)
crate.annotation(
    additive_build_file = "@rules_rs//3rd_party/aws-lc-sys:additive.BUILD.bazel",
    crate = "aws-lc-sys",
    extra_aliased_targets = {"aws_lc_sys_build_info": "aws_lc_sys_build_info"},
    gen_build_script = "off",
    rustc_flags = ["--cfg=use_bindgen_pregenerated"],
    # One version resolves here, so the target needs no version suffix.
    deps = ["@crates//:aws_lc_sys_build_info"],
)
crate.annotation(
    crate = "zstd-sys",
    gen_build_script = "off",
    deps = ["@zstd"],
)
use_repo(crate, "crates", "mutants")

inject_repo(crate, "aws-lc")

# Member directories for coordinated Git source dependencies.
[
    crate.annotation(
        crate = name,
        strip_prefix = directory,
        workspace_cargo_toml = "Cargo.toml",
    )
    for name, directory in {
        "krabka-admin-ui": "crates/admin-ui",
        "krabka-backup": "crates/backup-cli",
        "krabka-barrier": "crates/barrier-cli",
        "krabka-bench-driver": "crates/bench-driver",
        "krabka-blockstore": "crates/blockstore",
        "krabka-cli": "crates/krabka-cli",
        "krabka-connect": "crates/connect",
        "krabka-connect-derive": "crates/connect-derive",
        "krabka-connect-postgres": "crates/connect-postgres",
        "krabka-connect-worker": "crates/connect-worker",
        "krabka-docgen": "crates/docgen",
        "krabka-guard": "crates/guard-cli",
        "krabka-integration": "crates/integration",
        "krabka-log-iobench": "crates/log-iobench",
        "krabka-logql": "crates/logql",
        "krabka-metrics": "crates/metrics",
        "krabka-metrics-service": "crates/metrics-service",
        "krabka-o11y-verified": "crates/verified",
        "krabka-observability": "crates/observability",
        "krabka-operator": "crates/krabka-operator",
        "krabka-parse-benches": "crates/parse-benches",
        "krabka-pprof": "crates/pprof",
        "krabka-profiles": "crates/profiles",
        "krabka-promql": "crates/promql",
        "krabka-protocol-codegen": "crates/protocol-codegen",
        "krabka-query-frontend": "crates/query-frontend",
        "krabka-rebalancer": "crates/rebalancer",
        "krabka-replicator": "crates/replicator",
        "krabka-restore": "crates/restore",
        "krabka-schema-registry": "crates/schema-registry",
        "krabka-traceql": "crates/traceql",
        "krabka-traces": "crates/traces",
    }.items()
]
