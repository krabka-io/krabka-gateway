"""Root package: the public Krabka gateway surface."""

package(default_visibility = ["//visibility:public"])

# Cargo.lock/Cargo.toml are consumed by `crate.from_cargo` (see //MODULE.bazel);
# clippy.toml by the lint aspect in //tools/lint; .cargo/mutants.toml by the
# mutation sweep, via `--@rules_rs_mutants//mutants:config` in //.bazelrc.
exports_files([
    ".cargo/mutants.toml",
    "Cargo.lock",
    "Cargo.toml",
    "clippy.toml",
])

# The gateway server this repository ships.
alias(
    name = "gateway",
    actual = "//crates/gateway:krabka-gateway",
)

# The Rust application SDK.
alias(
    name = "app-sdk",
    actual = "//crates/app-sdk",
)

# The cross-language SDK conformance runner.
alias(
    name = "conformance",
    actual = "//crates/sdk-conformance:conformance",
)
