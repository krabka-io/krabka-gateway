# Macro package. See defs.bzl.
load(":protoc.bzl", "protoc_binary")

exports_files(["defs.bzl"])

# `$(execpath //bazel:protoc)` for the build scripts that generate prost types.
protoc_binary(
    name = "protoc",
    # A tool that the build scripts use. `manual` keeps `//...` from building
    # it as a target of its own.
    tags = ["manual"],
    visibility = ["//visibility:public"],
)
